# Tu perfil completo: CV (PDF), profile.json (contacto + RUT) y
# data_consolidada.md (historial privado de conversaciones).
perfiles/

# Perfil activo del sistema: contiene email, teléfono y RUT.
# (usa config/profile.example.json como plantilla para el tuyo)
apply_copilot/config/profile.json

# Todo el estado generado por las corridas: registro de rellenados,
# respuestas personales de formularios, cartas, sueldos, evidencias
# (capturas de pantalla), logs y bases de tu búsqueda.
apply_copilot/data/

# Dashboard generado (incluye datos de tus postulaciones).
apply_copilot/dashboard_interactivo.html
dashboard_interactivo.html

